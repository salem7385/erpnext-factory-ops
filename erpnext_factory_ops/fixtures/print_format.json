  "html": "<div class=\"print-format\" dir=\"rtl\" style=\"font-family: 'Arial', sans-serif; padding: 20px;\">\r\n    \r\n    <div style=\"display: flex; align-items: center; justify-content: space-between; border-bottom: 2px solid #005088; padding-bottom: 10px;\">\r\n        <div style=\"width: 35%; text-align: right;\">\r\n            <h3 style=\"margin: 0; color: #005088;\">مصنع تدوير الإطارات</h3>\r\n            <p style=\"margin: 2px 0; font-size: 10px;\">الرقم الضريبي: 310XXXXXXXXXXXX</p>\r\n        </div>\r\n\r\n        <div style=\"width: 20%; text-align: center;\">\r\n            <img src=\"/files/5555.jpeg\" style=\"max-height: 70px;\">\r\n        </div>\r\n\r\n        <div style=\"width: 35%; display: flex; align-items: center; justify-content: flex-end;\">\r\n            <div style=\"text-align: left; margin-left: 10px;\">\r\n                <h3 style=\"margin: 0; color: #005088;\">Tire Recycle</h3>\r\n            </div>\r\n            \r\n            <div style=\"border: 1px solid #000; padding: 2px;\">\r\n                {% set total_qty = doc.items | sum(attribute='qty') %}\r\n                {% set qr_data = \"ID:\" ~ doc.name ~ \"|Date:\" ~ doc.posting_date ~ \"|Qty:\" ~ total_qty %}\r\n                \r\n                <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=80x80&data={{ qr_data | urlencode }}\" \r\n                     style=\"width: 70px; height: 70px; display: block;\"\r\n                     onerror=\"this.src='{{ frappe.utils.make_base64_qrcode(qr_data) }}'\">\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div style=\"text-align: center; margin: 20px 0;\">\r\n        <h2 style=\"text-decoration: underline;\">طلب مواد مصنع</h2>\r\n        <p>رقم المستند: {{ doc.name }}</p>\r\n    </div>\r\n\r\n    <table style=\"width: 100%; border-collapse: collapse; border: 1px solid black;\">\r\n        <thead>\r\n            <tr style=\"background-color: #f2f2f2;\">\r\n                <th style=\"border: 1px solid black; padding: 8px;\">نوع الإطار</th>\r\n                <th style=\"border: 1px solid black; padding: 8px;\">الكمية</th>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n            <tr>\r\n                <td style=\"border: 1px solid black; padding: 8px; text-align: center;\">{{ item.tire_type }}</td>\r\n                <td style=\"border: 1px solid black; padding: 8px; text-align: center;\">{{ item.qty }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n</div>",
